<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Medical_atention.Controls"
             x:Class="Medical_atention.Views.ConsultationHistoryPage"
             Title="Historial de Consultas">

    <Grid RowDefinitions="Auto,*">
        <controls:OfflineBannerView x:Name="OfflineBanner" Grid.Row="0" />

        <StackLayout Grid.Row="1" Spacing="0">
            <Frame BackgroundColor="{StaticResource PrimaryLightColor}"
                   CornerRadius="0"
                   Padding="16,12"
                   HasShadow="False"
                   BorderColor="Transparent">
                <Label Text="{Binding PatientDisplayLine}"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light=#1A365D, Dark=#E2E8F0}" />
            </Frame>

            <StackLayout Padding="16,12,16,8" Spacing="10">

                <Grid ColumnDefinitions="72,*" ColumnSpacing="10">
                    <Label Text="Desde:"
                           Style="{StaticResource BodySecondaryStyle}"
                           VerticalOptions="Center" />
                    <Frame Grid.Column="1"
                           Style="{StaticResource InputFrameStyle}"
                           Padding="12,8"
                           HeightRequest="48">
                        <DatePicker Date="{Binding FilterFrom}"
                                    Format="dd/MM/yyyy"
                                    FontSize="15"
                                    TextColor="{AppThemeBinding Light=#1A365D, Dark=#E2E8F0}"
                                    VerticalOptions="Center"
                                    HorizontalOptions="FillAndExpand" />
                    </Frame>
                </Grid>

                <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="10">
                    <Label Text="Hasta:"
                           Style="{StaticResource BodySecondaryStyle}"
                           VerticalOptions="Center" />
                    <Frame Grid.Column="1"
                           Style="{StaticResource InputFrameStyle}"
                           Padding="12,8"
                           HeightRequest="48">
                        <DatePicker Date="{Binding FilterTo}"
                                    Format="dd/MM/yyyy"
                                    FontSize="15"
                                    TextColor="{AppThemeBinding Light=#1A365D, Dark=#E2E8F0}"
                                    VerticalOptions="Center"
                                    HorizontalOptions="FillAndExpand" />
                    </Frame>
                    <Button Grid.Column="2"
                            Text="Filtrar"
                            Command="{Binding FilterCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource PrimaryColor}"
                            FontSize="14"
                            FontAttributes="Bold"
                            Padding="12,0"
                            VerticalOptions="Center"
                            HeightRequest="48" />
                </Grid>

            </StackLayout>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Margin="0,8,0,0" />

            <CollectionView x:Name="ConsultationsList"
                          ItemsSource="{Binding Consultations}"
                          Margin="16,8,16,80"
                          SelectionMode="Single"
                          SelectionChanged="OnConsultationSelected">
                <CollectionView.EmptyView>
                    <controls:EmptyStateView
                        Icon="📁"
                        Title="Sin consultas en este período"
                        Subtitle="Este paciente aún no tiene consultas registradas." />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Style="{StaticResource CardFrameStyle}"
                               HasShadow="True"
                               Margin="0,0,0,10">
                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  ColumnDefinitions="*,Auto"
                                  RowSpacing="6"
                                  ColumnSpacing="8">
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding DateDisplay}"
                                       Style="{StaticResource CaptionStyle}" />
                                <controls:PriorityBadgeView Grid.Row="0" Grid.Column="1"
                                                            Grid.RowSpan="2"
                                                            Priority="{Binding Priority}"
                                                            Size="Small"
                                                            VerticalOptions="Start" />
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding DiagnosisTitle}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1A202C, Dark=#E2E8F0}"
                                       LineBreakMode="TailTruncation" />
                                <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding SummaryPreview}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#4A5568, Dark=#A0AEC0}"
                                       LineBreakMode="TailTruncation" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>
    </Grid>

</ContentPage>
