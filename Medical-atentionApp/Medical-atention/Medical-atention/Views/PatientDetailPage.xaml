<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Medical_atention.Controls"
             x:Class="Medical_atention.Views.PatientDetailPage"
             Title="Detalle del paciente">

    <Grid RowDefinitions="Auto,*,Auto">
        <controls:OfflineBannerView x:Name="OfflineBanner" Grid.Row="0" />

        <ScrollView Grid.Row="1">
            <StackLayout Padding="32,32,32,16" Spacing="0">

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Margin="0,40,0,0" />

                <StackLayout IsVisible="{Binding IsNotLoading}">

                    <Label Text="Nombre"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,0,4" />
                    <Frame Style="{StaticResource InputFrameStyle}" Padding="16,12" Margin="0,0,0,16">
                        <StackLayout>
                            <Label Text="{Binding Name}"
                                   IsVisible="{Binding IsReadOnly}"
                                   Style="{StaticResource BodyStyle}" />
                            <Entry Text="{Binding Name}"
                                   IsVisible="{Binding IsEditing}" />
                        </StackLayout>
                    </Frame>

                    <Label Text="Apellido"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,0,4" />
                    <Frame Style="{StaticResource InputFrameStyle}" Padding="16,12" Margin="0,0,0,16">
                        <StackLayout>
                            <Label Text="{Binding LastName}"
                                   IsVisible="{Binding IsReadOnly}"
                                   Style="{StaticResource BodyStyle}" />
                            <Entry Text="{Binding LastName}"
                                   IsVisible="{Binding IsEditing}" />
                        </StackLayout>
                    </Frame>

                    <Label Text="Cédula"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,0,4" />
                    <Frame Style="{StaticResource InputFrameStyle}" Padding="16,12" Margin="0,0,0,16">
                        <StackLayout>
                            <Label Text="{Binding IdentificationNumber}"
                                   IsVisible="{Binding IsReadOnly}"
                                   Style="{StaticResource BodyStyle}" />
                            <Entry Text="{Binding IdentificationNumber}"
                                   IsVisible="{Binding IsEditing}"
                                   Keyboard="Numeric" />
                        </StackLayout>
                    </Frame>

                    <Label Text="Fecha de nacimiento"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,0,4" />
                    <Frame Style="{StaticResource InputFrameStyle}" Padding="16,12" Margin="0,0,0,16">
                        <StackLayout>
                            <Label Text="{Binding DateOfBirth, StringFormat='{0:dd/MM/yyyy}'}"
                                   IsVisible="{Binding IsReadOnly}"
                                   Style="{StaticResource BodyStyle}" />
                            <DatePicker Date="{Binding DateOfBirth}"
                                        IsVisible="{Binding IsEditing}"
                                        MaximumDate="{Binding MaxDateOfBirth}"
                                        TextColor="{AppThemeBinding Light=#1A365D, Dark=#E2E8F0}"
                                        Format="dd/MM/yyyy" />
                        </StackLayout>
                    </Frame>

                    <Label Text="Género"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,0,4" />
                    <Frame Style="{StaticResource InputFrameStyle}" Padding="16,12" Margin="0,0,0,16">
                        <StackLayout>
                            <Label Text="{Binding Gender}"
                                   IsVisible="{Binding IsReadOnly}"
                                   Style="{StaticResource BodyStyle}" />
                            <Picker ItemsSource="{Binding Genders}"
                                    SelectedItem="{Binding SelectedGender}"
                                    IsVisible="{Binding IsEditing}"
                                    TextColor="{AppThemeBinding Light=#1A365D, Dark=#E2E8F0}" />
                        </StackLayout>
                    </Frame>

                    <Label Text="Registrado el"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,0,4" />
                    <Frame Style="{StaticResource InputFrameStyle}" Padding="16,12">
                        <Label Text="{Binding CreatedAt, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                               Style="{StaticResource BodyStyle}" />
                    </Frame>

                    <!-- Recordatorios -->
                    <Frame IsVisible="{Binding HasPendingReminders}"
                           BorderColor="{StaticResource WarningBorderColor}"
                           BackgroundColor="{StaticResource WarningLightColor}"
                           CornerRadius="8"
                           Padding="16,12"
                           HasShadow="False"
                           Margin="0,16,0,0">
                        <StackLayout Spacing="10">
                            <Label Text="Recordatorios de seguimiento"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource WarningTextColor}" />
                            <Label Text="{Binding ReminderInfoText}"
                                   FontSize="14"
                                   TextColor="{StaticResource WarningDarkTextColor}" />
                            <Button Text="Cancelar recordatorios"
                                    Command="{Binding CancelRemindersCommand}"
                                    BackgroundColor="{StaticResource WarningOrangeColor}"
                                    TextColor="White"
                                    CornerRadius="8"
                                    FontAttributes="Bold"
                                    HeightRequest="44" />
                        </StackLayout>
                    </Frame>

                    <Label Text="{Binding ReminderMessage}"
                           IsVisible="{Binding HasReminderMessage}"
                           TextColor="#2F855A" FontSize="13"
                           Margin="0,12,0,0" />

                    <Label Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorLabelStyle}"
                           FontSize="13"
                           IsVisible="{Binding HasError}"
                           Margin="0,16,0,0" />

                </StackLayout>

            </StackLayout>
        </ScrollView>

        <StackLayout Grid.Row="2"
                     Padding="32,8,32,24"
                     IsVisible="{Binding IsNotLoading}"
                     Spacing="8">

            <Button Text="Editar"
                    Command="{Binding EditCommand}"
                    IsVisible="{Binding ShowEditButton}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HeightRequest="48" />

            <Grid IsVisible="{Binding ShowSaveCancel}"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="Cancelar"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Grid.Column="1"
                        Text="Guardar"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HeightRequest="48" />
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsSaving}"
                               IsVisible="{Binding IsSaving}"
                               HorizontalOptions="Center" />

        </StackLayout>
    </Grid>

</ContentPage>
