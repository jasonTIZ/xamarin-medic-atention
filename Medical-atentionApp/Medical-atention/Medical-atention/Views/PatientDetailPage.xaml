<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Medical_atention.Views.PatientDetailPage"
             BackgroundColor="#F0F4F8"
             Title="Detalle del paciente">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <StackLayout Padding="32,32,32,16" Spacing="0">

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="#2C7BE5"
                                   Margin="0,40,0,0" />

                <StackLayout IsVisible="{Binding IsNotLoading}">

                    <Label Text="Nombre"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="#4A5568"
                           Margin="0,0,0,4" />
                    <Frame BorderColor="#CBD5E0" CornerRadius="8"
                           Padding="16,12" HasShadow="False"
                           BackgroundColor="White"
                           Margin="0,0,0,16">
                        <StackLayout>
                            <Label Text="{Binding Name}"
                                   IsVisible="{Binding IsReadOnly}"
                                   TextColor="#1A365D" FontSize="15" />
                            <Entry Text="{Binding Name}"
                                   IsVisible="{Binding IsEditing}"
                                   TextColor="#1A365D"
                                   BackgroundColor="Transparent" />
                        </StackLayout>
                    </Frame>

                    <Label Text="Apellido"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="#4A5568"
                           Margin="0,0,0,4" />
                    <Frame BorderColor="#CBD5E0" CornerRadius="8"
                           Padding="16,12" HasShadow="False"
                           BackgroundColor="White"
                           Margin="0,0,0,16">
                        <StackLayout>
                            <Label Text="{Binding LastName}"
                                   IsVisible="{Binding IsReadOnly}"
                                   TextColor="#1A365D" FontSize="15" />
                            <Entry Text="{Binding LastName}"
                                   IsVisible="{Binding IsEditing}"
                                   TextColor="#1A365D"
                                   BackgroundColor="Transparent" />
                        </StackLayout>
                    </Frame>

                    <Label Text="Cédula"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="#4A5568"
                           Margin="0,0,0,4" />
                    <Frame BorderColor="#CBD5E0" CornerRadius="8"
                           Padding="16,12" HasShadow="False"
                           BackgroundColor="White"
                           Margin="0,0,0,16">
                        <StackLayout>
                            <Label Text="{Binding IdentificationNumber}"
                                   IsVisible="{Binding IsReadOnly}"
                                   TextColor="#1A365D" FontSize="15" />
                            <Entry Text="{Binding IdentificationNumber}"
                                   IsVisible="{Binding IsEditing}"
                                   Keyboard="Numeric"
                                   TextColor="#1A365D"
                                   BackgroundColor="Transparent" />
                        </StackLayout>
                    </Frame>

                    <Label Text="Fecha de nacimiento"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="#4A5568"
                           Margin="0,0,0,4" />
                    <Frame BorderColor="#CBD5E0" CornerRadius="8"
                           Padding="16,12" HasShadow="False"
                           BackgroundColor="White"
                           Margin="0,0,0,16">
                        <StackLayout>
                            <Label Text="{Binding DateOfBirth, StringFormat='{0:dd/MM/yyyy}'}"
                                   IsVisible="{Binding IsReadOnly}"
                                   TextColor="#1A365D" FontSize="15" />
                            <DatePicker Date="{Binding DateOfBirth}"
                                        IsVisible="{Binding IsEditing}"
                                        MaximumDate="{Binding MaxDateOfBirth}"
                                        TextColor="#1A365D"
                                        Format="dd/MM/yyyy" />
                        </StackLayout>
                    </Frame>

                    <Label Text="Género"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="#4A5568"
                           Margin="0,0,0,4" />
                    <Frame BorderColor="#CBD5E0" CornerRadius="8"
                           Padding="16,12" HasShadow="False"
                           BackgroundColor="White"
                           Margin="0,0,0,16">
                        <StackLayout>
                            <Label Text="{Binding Gender}"
                                   IsVisible="{Binding IsReadOnly}"
                                   TextColor="#1A365D" FontSize="15" />
                            <Picker ItemsSource="{Binding Genders}"
                                    SelectedItem="{Binding SelectedGender}"
                                    IsVisible="{Binding IsEditing}"
                                    TextColor="#1A365D" />
                        </StackLayout>
                    </Frame>

                    <Label Text="Registrado el"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="#4A5568"
                           Margin="0,0,0,4" />
                    <Frame BorderColor="#CBD5E0" CornerRadius="8"
                           Padding="16,12" HasShadow="False"
                           BackgroundColor="White">
                        <Label Text="{Binding CreatedAt, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                               TextColor="#1A365D"
                               FontSize="15" />
                    </Frame>

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#E53E3E" FontSize="13"
                           IsVisible="{Binding HasError}"
                           Margin="0,16,0,0" />

                </StackLayout>

            </StackLayout>
        </ScrollView>

        <StackLayout Grid.Row="1"
                     Padding="32,8,32,24"
                     IsVisible="{Binding IsNotLoading}"
                     Spacing="8">

            <Button Text="Editar"
                    Command="{Binding EditCommand}"
                    IsVisible="{Binding ShowEditButton}"
                    BackgroundColor="#2C7BE5"
                    TextColor="White"
                    CornerRadius="8"
                    FontAttributes="Bold"
                    HeightRequest="48" />

            <Grid IsVisible="{Binding ShowSaveCancel}"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="Cancelar"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="#E2E8F0"
                        TextColor="#4A5568"
                        CornerRadius="8"
                        FontAttributes="Bold"
                        HeightRequest="48" />
                <Button Grid.Column="1"
                        Text="Guardar"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="#2C7BE5"
                        TextColor="White"
                        CornerRadius="8"
                        FontAttributes="Bold"
                        HeightRequest="48" />
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsSaving}"
                               IsVisible="{Binding IsSaving}"
                               Color="#2C7BE5"
                               HorizontalOptions="Center" />

        </StackLayout>
    </Grid>

</ContentPage>
