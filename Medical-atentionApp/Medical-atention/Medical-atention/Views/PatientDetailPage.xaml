<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Medical_atention.Views.PatientDetailPage"
             BackgroundColor="#F0F4F8"
             Title="Detalle del paciente">

    <ScrollView>
        <StackLayout Padding="32,32,32,32" Spacing="0">

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="#2C7BE5"
                               Margin="0,40,0,0" />

            <StackLayout IsVisible="{Binding IsNotLoading}">

                <Label Text="Nombre"
                       FontSize="13" FontAttributes="Bold"
                       TextColor="#4A5568"
                       Margin="0,0,0,4" />
                <Frame BorderColor="#CBD5E0" CornerRadius="8"
                       Padding="12,0" HasShadow="False"
                       BackgroundColor="White"
                       Margin="0,0,0,16">
                    <Entry Text="{Binding Name}"
                           IsEnabled="{Binding IsEditing}"
                           TextColor="#1A365D"
                           BackgroundColor="Transparent" />
                </Frame>

                <Label Text="Apellido"
                       FontSize="13" FontAttributes="Bold"
                       TextColor="#4A5568"
                       Margin="0,0,0,4" />
                <Frame BorderColor="#CBD5E0" CornerRadius="8"
                       Padding="12,0" HasShadow="False"
                       BackgroundColor="White"
                       Margin="0,0,0,16">
                    <Entry Text="{Binding LastName}"
                           IsEnabled="{Binding IsEditing}"
                           TextColor="#1A365D"
                           BackgroundColor="Transparent" />
                </Frame>

                <Label Text="Cédula"
                       FontSize="13" FontAttributes="Bold"
                       TextColor="#4A5568"
                       Margin="0,0,0,4" />
                <Frame BorderColor="#CBD5E0" CornerRadius="8"
                       Padding="12,0" HasShadow="False"
                       BackgroundColor="White"
                       Margin="0,0,0,16">
                    <Entry Text="{Binding IdentificationNumber}"
                           IsEnabled="{Binding IsEditing}"
                           Keyboard="Numeric"
                           TextColor="#1A365D"
                           BackgroundColor="Transparent" />
                </Frame>

                <Label Text="Fecha de nacimiento"
                       FontSize="13" FontAttributes="Bold"
                       TextColor="#4A5568"
                       Margin="0,0,0,4" />
                <Frame BorderColor="#CBD5E0" CornerRadius="8"
                       Padding="12,4" HasShadow="False"
                       BackgroundColor="White"
                       Margin="0,0,0,16">
                    <DatePicker Date="{Binding DateOfBirth}"
                                IsEnabled="{Binding IsEditing}"
                                MaximumDate="{Binding MaxDateOfBirth}"
                                TextColor="#1A365D"
                                Format="dd/MM/yyyy" />
                </Frame>

                <Label Text="Género"
                       FontSize="13" FontAttributes="Bold"
                       TextColor="#4A5568"
                       Margin="0,0,0,4" />
                <Frame BorderColor="#CBD5E0" CornerRadius="8"
                       Padding="12,0" HasShadow="False"
                       BackgroundColor="White"
                       Margin="0,0,0,16">
                    <Picker ItemsSource="{Binding Genders}"
                            SelectedItem="{Binding SelectedGender}"
                            IsEnabled="{Binding IsEditing}"
                            TextColor="#1A365D" />
                </Frame>

                <Label Text="Registrado el"
                       FontSize="13" FontAttributes="Bold"
                       TextColor="#4A5568"
                       Margin="0,0,0,4" />
                <Frame BorderColor="#CBD5E0" CornerRadius="8"
                       Padding="16,12" HasShadow="False"
                       BackgroundColor="White"
                       Margin="0,0,0,16">
                    <Label Text="{Binding CreatedAt, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                           TextColor="#1A365D"
                           FontSize="15" />
                </Frame>

                <Label Text="{Binding ErrorMessage}"
                       TextColor="#E53E3E" FontSize="13"
                       IsVisible="{Binding HasError}"
                       Margin="0,0,0,8" />

                <Button Text="Editar"
                        Command="{Binding EditCommand}"
                        IsVisible="{Binding ShowEditButton}"
                        BackgroundColor="#2C7BE5"
                        TextColor="White"
                        CornerRadius="8"
                        FontAttributes="Bold"
                        HeightRequest="48"
                        Margin="0,8,0,0" />

                <Grid IsVisible="{Binding ShowSaveCancel}"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="12"
                      Margin="0,8,0,0">
                    <Button Grid.Column="0"
                            Text="Cancelar"
                            Command="{Binding CancelCommand}"
                            BackgroundColor="#E2E8F0"
                            TextColor="#4A5568"
                            CornerRadius="8"
                            FontAttributes="Bold"
                            HeightRequest="48" />
                    <Button Grid.Column="1"
                            Text="Guardar"
                            Command="{Binding SaveCommand}"
                            BackgroundColor="#2C7BE5"
                            TextColor="White"
                            CornerRadius="8"
                            FontAttributes="Bold"
                            HeightRequest="48" />
                </Grid>

                <ActivityIndicator IsRunning="{Binding IsSaving}"
                                   IsVisible="{Binding IsSaving}"
                                   Color="#2C7BE5"
                                   Margin="0,16,0,0" />

            </StackLayout>

        </StackLayout>
    </ScrollView>

</ContentPage>
