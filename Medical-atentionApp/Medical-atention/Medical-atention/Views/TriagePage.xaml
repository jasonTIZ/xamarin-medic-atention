<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:Medical_atention.Converters"
             xmlns:controls="clr-namespace:Medical_atention.Controls"
             x:Class="Medical_atention.Views.TriagePage"
             Title="Triaje">

    <ContentPage.Resources>
        <conv:PriorityLevelToColorConverter x:Key="PriorityColorConverter" />
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:OfflineBannerView x:Name="OfflineBanner" Grid.Row="0" />

        <RefreshView x:Name="RefreshHost"
                     Grid.Row="1"
                     Refreshing="OnRefreshing">
            <Grid>
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center" />

                <!-- Estado vacío -->
                <controls:EmptyStateView
                    IsVisible="{Binding IsEmpty}"
                    Icon="⚕"
                    Title="No hay pacientes para triaje"
                    Subtitle="Los pacientes aparecerán aquí cuando se registren"
                    VerticalOptions="Center"
                    HorizontalOptions="Center" />

                <CollectionView x:Name="TriageList"
                              ItemsSource="{Binding Groups}"
                              IsGrouped="True"
                              IsVisible="{Binding HasPatients}">
                    <CollectionView.GroupHeaderTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="{Binding BackgroundColor}"
                                   CornerRadius="8"
                                   Padding="12,8"
                                   Margin="16,12,16,4"
                                   HasShadow="False"
                                   BorderColor="Transparent">
                                <Label Text="{Binding Title}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="Black" />
                            </Frame>
                        </DataTemplate>
                    </CollectionView.GroupHeaderTemplate>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal">
                                        <SwipeItem Text="Prioridad"
                                                   BackgroundColor="{StaticResource PrimaryColor}"
                                                   Invoked="OnSwipePriorityInvoked" />
                                    </SwipeItems>
                                </SwipeView.RightItems>
                                <Frame BorderColor="{AppThemeBinding Light=#CBD5E0, Dark=#4A5568}"
                                       CornerRadius="8"
                                       Padding="12"
                                       HasShadow="False"
                                       BackgroundColor="{AppThemeBinding Light=White, Dark=#2D3748}"
                                       Margin="16,4,16,4">
                                    <StackLayout Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding FullName}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#1A365D, Dark=#E2E8F0}" />
                                            <Frame Grid.Column="1"
                                                   Padding="8,2"
                                                   CornerRadius="12"
                                                   HasShadow="False"
                                                   BorderColor="Transparent"
                                                   BackgroundColor="{Binding Priority, Converter={StaticResource PriorityColorConverter}}">
                                                <Frame.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnPriorityBadgeTapped" />
                                                </Frame.GestureRecognizers>
                                                <Label Text="{Binding PriorityLabel}"
                                                       FontSize="11"
                                                       TextColor="White" />
                                            </Frame>
                                        </Grid>
                                        <Label Text="{Binding IdentificationNumber, StringFormat='Cédula: {0}'}"
                                               Style="{StaticResource CaptionStyle}" />
                                        <Label Text="{Binding LastConsultationText}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light=#4A5568, Dark=#A0AEC0}" />
                                        <Button Text="Registrar consulta"
                                                FontSize="12"
                                                BackgroundColor="{StaticResource PrimaryLightColor}"
                                                TextColor="{StaticResource PrimaryColor}"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                HorizontalOptions="Start"
                                                Clicked="OnRegisterConsultationClicked" />
                                    </StackLayout>
                                </Frame>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </RefreshView>

        <Frame Grid.Row="1"
               VerticalOptions="End"
               HorizontalOptions="FillAndExpand"
               IsVisible="{Binding IsSnackbarVisible}"
               Style="{StaticResource SnackbarFrameStyle}"
               Margin="16,0,16,16">
            <Label Text="{Binding SnackbarMessage}"
                   TextColor="White"
                   FontSize="13"
                   HorizontalTextAlignment="Center" />
        </Frame>
    </Grid>
</ContentPage>
