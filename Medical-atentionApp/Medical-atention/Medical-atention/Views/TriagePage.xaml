<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Medical_atention.Controls"
             x:Class="Medical_atention.Views.TriagePage"
             BackgroundColor="#F0F4F8"
             Title="Triaje">

    <ScrollView>
        <StackLayout Padding="16,16,16,24" Spacing="16">

            <Label Text="Cola de espera"
                   FontSize="16" FontAttributes="Bold"
                   TextColor="#1A365D" />

            <CollectionView ItemsSource="{Binding Queue}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="#E2E8F0" CornerRadius="12"
                               Padding="16,12" HasShadow="False"
                               BackgroundColor="White"
                               Margin="0,0,0,10">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding PatientName}"
                                       FontSize="15" FontAttributes="Bold"
                                       TextColor="#1A202C" />
                                <controls:PriorityBadgeView Grid.Row="0" Grid.Column="1"
                                                            Priority="{Binding Priority}"
                                                            Size="Medium"
                                                            VerticalOptions="Center" />
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding IdentificationNumber, StringFormat='Cédula: {0}'}"
                                       FontSize="12" TextColor="#718096" />
                                <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding ChiefComplaint}"
                                       FontSize="13" TextColor="#4A5568" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Referencia de tamaños"
                   FontSize="14" FontAttributes="Bold"
                   TextColor="#4A5568"
                   Margin="0,8,0,0" />
            <StackLayout Orientation="Horizontal" Spacing="8">
                <controls:PriorityBadgeView Priority="urgent" Size="Small" />
                <controls:PriorityBadgeView Priority="high" Size="Medium" />
                <controls:PriorityBadgeView Priority="low" Size="Large" />
            </StackLayout>

        </StackLayout>
    </ScrollView>

</ContentPage>
