<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Medical_atention.Controls"
             x:Class="Medical_atention.Views.RegisterConsultationPage"
             Title="Nueva Consulta">

    <Grid RowDefinitions="Auto,*">
        <controls:OfflineBannerView x:Name="OfflineBanner" Grid.Row="0" />

        <Grid Grid.Row="1">
        <ScrollView>
            <StackLayout Padding="24,20,24,100" Spacing="0">

                <Label Text="{Binding PatientDisplayLine}"
                       Style="{StaticResource BodySecondaryStyle}"
                       Margin="0,0,0,20" />

                <Label Text="Fecha y Hora de la Consulta"
                       Style="{StaticResource FieldLabelStyle}"
                       Margin="0,0,0,6" />
                <Frame Style="{StaticResource InputFrameStyle}" Padding="14,12" Margin="0,0,0,6">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackLayout Grid.Column="0" Spacing="8"
                                     IsVisible="{Binding IsDateTimeReadOnly}">
                            <Label Text="{Binding ConsultationDateTimeDisplay}"
                                   Style="{StaticResource BodyStyle}"
                                   VerticalOptions="Center" />
                        </StackLayout>
                        <Label Grid.Column="1"
                               Text="📅"
                               FontSize="18"
                               VerticalOptions="Center"
                               IsVisible="{Binding IsDateTimeReadOnly}" />
                        <StackLayout Grid.Column="0" Grid.ColumnSpan="2"
                                     IsVisible="{Binding IsEditingDateTime}"
                                     Spacing="8">
                            <DatePicker Date="{Binding ConsultationDate}"
                                        Format="dd/MM/yyyy"
                                        TextColor="{AppThemeBinding Light=#1A365D, Dark=#E2E8F0}" />
                            <TimePicker Time="{Binding ConsultationTime}"
                                        TextColor="{AppThemeBinding Light=#1A365D, Dark=#E2E8F0}" />
                        </StackLayout>
                    </Grid>
                </Frame>
                <Label Text="Editar fecha/hora"
                       FontSize="13"
                       TextColor="{StaticResource PrimaryColor}"
                       Margin="0,0,0,20">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleEditDateTimeCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <Label Text="Prioridad"
                       Style="{StaticResource FieldLabelStyle}"
                       Margin="0,0,0,8" />
                <StackLayout Orientation="Horizontal"
                             Spacing="8"
                             Margin="0,0,0,20"
                             BindableLayout.ItemsSource="{Binding PriorityOptions}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Frame BorderColor="{Binding BorderColor}"
                                   BackgroundColor="{AppThemeBinding Light=White, Dark=#2D3748}"
                                   CornerRadius="20"
                                   Padding="4,6"
                                   HasShadow="False"
                                   HorizontalOptions="FillAndExpand">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SelectCommand}"
                                                          CommandParameter="{Binding Key}" />
                                </Frame.GestureRecognizers>
                                <controls:PriorityBadgeView Priority="{Binding Key}"
                                                            Size="Small"
                                                            HorizontalOptions="Center" />
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </StackLayout>

                <StackLayout Orientation="Horizontal" Spacing="2" Margin="0,0,0,4">
                    <Label Text="Síntomas" Style="{StaticResource FieldLabelStyle}" />
                    <Label Text="*" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource ErrorColor}" />
                </StackLayout>
                <Frame Style="{StaticResource InputFrameStyle}" Padding="12,8" Margin="0,0,0,4">
                    <Editor Text="{Binding Symptoms}"
                            Placeholder="Describa los síntomas del paciente"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="120" />
                </Frame>
                <Label Text="{Binding SymptomsError}"
                       Style="{StaticResource ErrorLabelStyle}"
                       IsVisible="{Binding HasSymptomsError}"
                       Margin="4,0,0,12" />

                <StackLayout Orientation="Horizontal" Spacing="2" Margin="0,0,0,4">
                    <Label Text="Diagnóstico" Style="{StaticResource FieldLabelStyle}" />
                    <Label Text="*" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource ErrorColor}" />
                </StackLayout>
                <Frame Style="{StaticResource InputFrameStyle}" Padding="12,8" Margin="0,0,0,4">
                    <Editor Text="{Binding Diagnosis}"
                            Placeholder="Diagnóstico médico"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="90" />
                </Frame>
                <Label Text="{Binding DiagnosisError}"
                       Style="{StaticResource ErrorLabelStyle}"
                       IsVisible="{Binding HasDiagnosisError}"
                       Margin="4,0,0,16" />

                <Label Text="Tratamiento"
                       Style="{StaticResource FieldLabelStyle}"
                       Margin="0,0,0,4" />
                <Frame Style="{StaticResource InputFrameStyle}" Margin="0,0,0,16">
                    <Entry Text="{Binding Treatment}"
                           Placeholder="Tratamiento indicado" />
                </Frame>

                <Label Text="Notas"
                       Style="{StaticResource FieldLabelStyle}"
                       Margin="0,0,0,4" />
                <Frame Style="{StaticResource InputFrameStyle}" Padding="12,8" Margin="0,0,0,20">
                    <Editor Text="{Binding Notes}"
                            Placeholder="Notas adicionales"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="90" />
                </Frame>

                <!-- Imágenes adjuntas -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                    <Label Grid.Column="0"
                           Text="Imágenes adjuntas"
                           Style="{StaticResource FieldLabelStyle}"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding ImageCountLabel}"
                           Style="{StaticResource CaptionStyle}"
                           VerticalOptions="Center" />
                </Grid>

                <CollectionView ItemsSource="{Binding PreviewImages}"
                                IsVisible="{Binding HasImages}"
                                HeightRequest="110"
                                ItemsLayout="HorizontalList"
                                Margin="0,0,0,8">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid WidthRequest="96" HeightRequest="96" Margin="0,4,8,4">
                                <Frame CornerRadius="8" Padding="0"
                                       IsClippedToBounds="True"
                                       HasShadow="False"
                                       BorderColor="{AppThemeBinding Light=#CBD5E0, Dark=#4A5568}">
                                    <Image Source="{Binding Source}"
                                           Aspect="AspectFill"
                                           WidthRequest="96"
                                           HeightRequest="96" />
                                </Frame>
                                <Button Text="&#x2715;"
                                        TextColor="White"
                                        BackgroundColor="#CC000000"
                                        FontSize="14"
                                        CornerRadius="12"
                                        WidthRequest="24"
                                        HeightRequest="24"
                                        Padding="0"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        Margin="0,4,4,0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveImageCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8"
                      IsVisible="{Binding CanAddImage}"
                      Margin="0,0,0,4">
                    <Button Grid.Column="0"
                            Text="&#x1F4F7; Cámara"
                            Command="{Binding AddFromCameraCommand}"
                            Style="{StaticResource OutlineButtonStyle}" />
                    <Button Grid.Column="1"
                            Text="&#x1F5BC; Galería"
                            Command="{Binding AddFromGalleryCommand}"
                            Style="{StaticResource OutlineButtonStyle}" />
                </Grid>

                <Label Text="{Binding AttachmentError}"
                       Style="{StaticResource ErrorLabelStyle}"
                       IsVisible="{Binding HasAttachmentError}"
                       Margin="0,0,0,12" />

                <Frame IsVisible="{Binding HasGeneralError}"
                       Style="{StaticResource ErrorFrameStyle}"
                       Margin="0,0,0,12">
                    <Label Text="{Binding GeneralError}"
                           TextColor="{StaticResource ErrorDarkColor}"
                           FontSize="14"
                           HorizontalOptions="Center" />
                </Frame>

                <Button Text="GUARDAR CONSULTA"
                        Command="{Binding RegisterCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        FontSize="15"
                        HeightRequest="52"
                        CharacterSpacing="0.5" />

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Margin="0,16,0,0" />

            </StackLayout>
        </ScrollView>

        <Frame IsVisible="{Binding IsSnackbarVisible}"
               Style="{StaticResource SnackbarFrameStyle}"
               Margin="20,0,20,88"
               VerticalOptions="End"
               HorizontalOptions="Fill">
            <Label Text="{Binding SnackbarMessage}"
                   TextColor="White"
                   FontSize="14"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
        </Frame>
        </Grid>
    </Grid>

</ContentPage>
