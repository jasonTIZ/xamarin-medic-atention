<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Medical_atention.ViewModels"
             x:Class="Medical_atention.Views.ProfilePage"
             Title="Perfil">

    <ContentPage.BindingContext>
        <vm:ProfileViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <StackLayout Padding="24,32,24,32" Spacing="0">

            <!-- Tarjeta de usuario -->
            <Frame Style="{StaticResource CardFrameStyle}" HasShadow="True" Margin="0,0,0,24">
                <StackLayout Spacing="6">
                    <Label Text="{Binding UserName}"
                           Style="{StaticResource TitleStyle}"
                           FontSize="20" />
                    <Label Text="{Binding UserRole}"
                           FontSize="14"
                           TextColor="{StaticResource PrimaryColor}"
                           FontAttributes="Bold" />
                    <Label Text="{Binding UserEmail}"
                           Style="{StaticResource CaptionStyle}"
                           FontSize="14"
                           Margin="0,4,0,0" />
                </StackLayout>
            </Frame>

            <!-- Éxito -->
            <Frame IsVisible="{Binding HasSuccessMessage}"
                   BackgroundColor="{StaticResource SuccessLightColor}"
                   BorderColor="{StaticResource SuccessBorderColor}"
                   CornerRadius="8"
                   Padding="12,10"
                   Margin="0,0,0,16"
                   HasShadow="False">
                <Label Text="{Binding SuccessMessage}"
                       TextColor="{StaticResource SuccessTextColor}"
                       FontSize="14"
                       HorizontalOptions="Center" />
            </Frame>

            <Label Text="Cambiar contraseña"
                   Style="{StaticResource SectionHeaderStyle}"
                   Margin="0,0,0,16" />

            <Label Text="Contraseña actual"
                   Style="{StaticResource FieldLabelStyle}"
                   Margin="0,0,0,4" />
            <Frame Style="{StaticResource InputFrameStyle}">
                <Entry Text="{Binding CurrentPassword}"
                       Placeholder="••••••••"
                       IsPassword="True" />
            </Frame>
            <Label Text="{Binding CurrentPasswordError}"
                   Style="{StaticResource ErrorLabelStyle}"
                   IsVisible="{Binding HasCurrentPasswordError}"
                   Margin="4,4,0,8" />

            <Label Text="Nueva contraseña"
                   Style="{StaticResource FieldLabelStyle}"
                   Margin="0,8,0,4" />
            <Frame Style="{StaticResource InputFrameStyle}">
                <Entry Text="{Binding NewPassword}"
                       Placeholder="Mínimo 8 caracteres"
                       IsPassword="True" />
            </Frame>
            <Label Text="{Binding NewPasswordError}"
                   Style="{StaticResource ErrorLabelStyle}"
                   IsVisible="{Binding HasNewPasswordError}"
                   Margin="4,4,0,8" />

            <Label Text="Confirmar nueva contraseña"
                   Style="{StaticResource FieldLabelStyle}"
                   Margin="0,8,0,4" />
            <Frame Style="{StaticResource InputFrameStyle}">
                <Entry Text="{Binding ConfirmPassword}"
                       Placeholder="Repite la nueva contraseña"
                       IsPassword="True" />
            </Frame>
            <Label Text="{Binding ConfirmPasswordError}"
                   Style="{StaticResource ErrorLabelStyle}"
                   IsVisible="{Binding HasConfirmPasswordError}"
                   Margin="4,4,0,0" />

            <Button Text="Guardar cambios"
                    Command="{Binding ChangePasswordCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    FontSize="15"
                    HeightRequest="50"
                    Margin="0,24,0,0" />

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Margin="0,12,0,0" />

            <Button Text="Cerrar sesión"
                    Command="{Binding LogoutCommand}"
                    Style="{StaticResource DangerButtonStyle}"
                    Margin="0,16,0,0" />

        </StackLayout>
    </ScrollView>

</ContentPage>
