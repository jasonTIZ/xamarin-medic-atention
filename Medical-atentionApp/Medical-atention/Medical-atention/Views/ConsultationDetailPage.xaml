<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Medical_atention.Controls"
             x:Class="Medical_atention.Views.ConsultationDetailPage"
             BackgroundColor="#F0F4F8"
             Title="Detalle de consulta">

    <ScrollView>
        <StackLayout Padding="32,24,32,32" Spacing="0">

            <Frame BorderColor="#E2E8F0" CornerRadius="12"
                   Padding="20,16" HasShadow="False"
                   BackgroundColor="White"
                   Margin="0,0,0,20">
                <StackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding PatientName}"
                               FontSize="18" FontAttributes="Bold"
                               TextColor="#1A202C"
                               VerticalOptions="Center" />
                        <controls:PriorityBadgeView Grid.Column="1"
                                                    Priority="{Binding Priority}"
                                                    Size="Large"
                                                    VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{Binding Status, StringFormat='Estado: {0}'}"
                           FontSize="13" TextColor="#718096" />
                </StackLayout>
            </Frame>

            <Label Text="Motivo de consulta"
                   FontSize="13" FontAttributes="Bold"
                   TextColor="#4A5568"
                   Margin="0,0,0,4" />
            <Frame BorderColor="#CBD5E0" CornerRadius="8"
                   Padding="16,12" HasShadow="False"
                   BackgroundColor="White">
                <Label Text="{Binding ChiefComplaint}"
                       FontSize="15" TextColor="#1A365D" />
            </Frame>

        </StackLayout>
    </ScrollView>

</ContentPage>
