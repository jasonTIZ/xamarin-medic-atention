<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Medical_atention.Controls"
             x:Class="Medical_atention.Views.ConsultationDetailPage"
             Title="Detalle de consulta">

    <Grid RowDefinitions="Auto,*,Auto">
        <controls:OfflineBannerView x:Name="OfflineBanner" Grid.Row="0" />

        <ScrollView Grid.Row="1">
            <StackLayout Padding="24,20,24,16" Spacing="0">

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Margin="0,40,0,0" />

                <StackLayout IsVisible="{Binding IsNotLoading}" Spacing="0">

                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                        <Label Text="{Binding DateDisplay}"
                               Style="{StaticResource CaptionStyle}"
                               FontSize="14"
                               VerticalOptions="Center" />
                        <controls:PriorityBadgeView Grid.Column="1"
                                                    Priority="{Binding Priority}"
                                                    Size="Medium"
                                                    VerticalOptions="Center" />
                    </Grid>

                    <Label Text="Diagnóstico"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,0,4" />
                    <Frame Style="{StaticResource InputFrameStyle}" Padding="16,12" Margin="0,0,0,16">
                        <Label Text="{Binding Diagnosis}"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1A202C, Dark=#E2E8F0}" />
                    </Frame>

                    <Label Text="Síntomas"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,0,4" />
                    <Frame Style="{StaticResource InputFrameStyle}" Padding="16,12" Margin="0,0,0,16">
                        <Label Text="{Binding Symptoms}" Style="{StaticResource BodyStyle}" />
                    </Frame>

                    <Label Text="Tratamiento"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,0,4" />
                    <Frame Style="{StaticResource InputFrameStyle}" Padding="16,12" Margin="0,0,0,16">
                        <StackLayout>
                            <Label Text="{Binding TreatmentReadOnly}"
                                   IsVisible="{Binding IsReadOnly}"
                                   Style="{StaticResource BodyStyle}" />
                            <Editor Text="{Binding Treatment}"
                                    IsVisible="{Binding IsEditing}"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="80"
                                    Placeholder="Tratamiento indicado" />
                        </StackLayout>
                    </Frame>

                    <Label Text="Notas"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,0,4" />
                    <Frame Style="{StaticResource InputFrameStyle}" Padding="16,12" Margin="0,0,0,8">
                        <StackLayout>
                            <Label Text="{Binding NotesReadOnly}"
                                   IsVisible="{Binding IsReadOnly}"
                                   Style="{StaticResource BodyStyle}" />
                            <Editor Text="{Binding Notes}"
                                    IsVisible="{Binding IsEditing}"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="80"
                                    Placeholder="Notas adicionales" />
                        </StackLayout>
                    </Frame>

                    <Label Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorLabelStyle}"
                           FontSize="13"
                           IsVisible="{Binding HasError}"
                           Margin="0,8,0,0" />

                    <!-- Imágenes adjuntas -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,20,0,6">
                        <Label Grid.Column="0"
                               Text="Imágenes adjuntas"
                               Style="{StaticResource FieldLabelStyle}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding AttachmentCountLabel}"
                               Style="{StaticResource CaptionStyle}"
                               VerticalOptions="Center" />
                    </Grid>

                    <ActivityIndicator IsRunning="{Binding IsLoadingAttachments}"
                                       IsVisible="{Binding IsLoadingAttachments}"
                                       HeightRequest="32"
                                       Margin="0,4,0,4" />

                    <CollectionView ItemsSource="{Binding Attachments}"
                                    IsVisible="{Binding HasAttachments}"
                                    HeightRequest="110"
                                    ItemsLayout="HorizontalList"
                                    Margin="0,0,0,8">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid WidthRequest="96" HeightRequest="96" Margin="0,4,8,4">
                                    <Frame CornerRadius="8" Padding="0"
                                           IsClippedToBounds="True"
                                           HasShadow="False"
                                           BorderColor="{AppThemeBinding Light=#CBD5E0, Dark=#4A5568}">
                                        <Image Source="{Binding ThumbnailSource}"
                                               Aspect="AspectFill"
                                               WidthRequest="96"
                                               HeightRequest="96">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenViewerCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </Frame>
                                    <StackLayout IsVisible="{Binding ShowProgress}"
                                                 VerticalOptions="End"
                                                 BackgroundColor="#CC000000"
                                                 Padding="6,4">
                                        <ProgressBar Progress="{Binding UploadProgress}"
                                                     ProgressColor="{StaticResource PrimaryColor}"
                                                     HeightRequest="4" />
                                        <Label Text="{Binding UploadProgressText}"
                                               TextColor="White"
                                               FontSize="10"
                                               HorizontalOptions="Center" />
                                    </StackLayout>
                                    <Frame IsVisible="{Binding PendingSync}"
                                           CornerRadius="6"
                                           Padding="4,2"
                                           BackgroundColor="{StaticResource WarningBorderColor}"
                                           HasShadow="False"
                                           HorizontalOptions="Start"
                                           VerticalOptions="Start"
                                           Margin="4">
                                        <Label Text="Offline" FontSize="9" TextColor="White" />
                                    </Frame>
                                    <Button Text="&#x2715;"
                                            TextColor="White"
                                            BackgroundColor="#CC000000"
                                            FontSize="14"
                                            CornerRadius="12"
                                            WidthRequest="24"
                                            HeightRequest="24"
                                            Padding="0"
                                            HorizontalOptions="End"
                                            VerticalOptions="Start"
                                            Margin="0,4,4,0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteAttachmentCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"
                          IsVisible="{Binding CanAddAttachment}"
                          Margin="0,0,0,4">
                        <Button Grid.Column="0"
                                Text="&#x1F4F7; Cámara"
                                Command="{Binding AddFromCameraCommand}"
                                Style="{StaticResource OutlineButtonStyle}" />
                        <Button Grid.Column="1"
                                Text="&#x1F5BC; Galería"
                                Command="{Binding AddFromGalleryCommand}"
                                Style="{StaticResource OutlineButtonStyle}" />
                    </Grid>

                    <Label Text="{Binding AttachmentError}"
                           Style="{StaticResource ErrorLabelStyle}"
                           IsVisible="{Binding HasAttachmentError}"
                           Margin="0,4,0,0" />

                </StackLayout>

            </StackLayout>
        </ScrollView>

        <StackLayout Grid.Row="2"
                     Padding="24,8,24,24"
                     IsVisible="{Binding IsNotLoading}"
                     Spacing="8">

            <Button Text="Editar"
                    Command="{Binding EditCommand}"
                    IsVisible="{Binding ShowEditButton}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HeightRequest="48" />

            <Grid IsVisible="{Binding ShowSaveCancel}"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="Cancelar"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Grid.Column="1"
                        Text="Guardar"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HeightRequest="48" />
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsSaving}"
                               IsVisible="{Binding IsSaving}"
                               HorizontalOptions="Center" />

        </StackLayout>
    </Grid>

</ContentPage>
