<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Medical_atention.Views.LoginPage"
             Title="">

    <ScrollView>
        <StackLayout Padding="32,60,32,32" Spacing="0">

            <!-- Header -->
            <Frame BackgroundColor="{StaticResource PrimaryColor}" CornerRadius="40"
                   HeightRequest="80" WidthRequest="80"
                   HorizontalOptions="Center" HasShadow="True"
                   Margin="0,0,0,16">
                <Label Text="+" FontSize="52" FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>

            <Label Text="Sistema Médico Rural"
                   Style="{StaticResource TitleStyle}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,4" />

            <Label Text="Ingresa con tus credenciales"
                   Style="{StaticResource SubtitleStyle}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,40" />

            <!-- Email -->
            <Label Text="Correo electrónico"
                   Style="{StaticResource FieldLabelStyle}"
                   Margin="0,0,0,4" />
            <Frame Style="{StaticResource InputFrameStyle}">
                <Entry x:Name="EmailEntry"
                       Text="{Binding Email}"
                       Placeholder="correo@ejemplo.com"
                       Keyboard="Email"
                       ReturnType="Next" />
            </Frame>
            <Label Text="{Binding EmailError}"
                   Style="{StaticResource ErrorLabelStyle}"
                   IsVisible="{Binding HasEmailError}"
                   Margin="4,4,0,0" />

            <!-- Password -->
            <Label Text="Contraseña"
                   Style="{StaticResource FieldLabelStyle}"
                   Margin="0,16,0,4" />
            <Frame Style="{StaticResource InputFrameStyle}">
                <Entry Text="{Binding Password}"
                       Placeholder="••••••••"
                       IsPassword="True" />
            </Frame>
            <Label Text="{Binding PasswordError}"
                   Style="{StaticResource ErrorLabelStyle}"
                   IsVisible="{Binding HasPasswordError}"
                   Margin="4,4,0,0" />

            <!-- Error general -->
            <Frame IsVisible="{Binding HasGeneralError}"
                   Style="{StaticResource ErrorFrameStyle}"
                   Margin="0,16,0,0">
                <Label Text="{Binding GeneralError}"
                       TextColor="{StaticResource ErrorDarkColor}"
                       FontSize="14"
                       HorizontalOptions="Center" />
            </Frame>

            <!-- Botón login -->
            <Button Text="Iniciar sesión"
                    Command="{Binding LoginCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,24,0,0" />

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Margin="0,16,0,0" />

        </StackLayout>
    </ScrollView>

</ContentPage>
