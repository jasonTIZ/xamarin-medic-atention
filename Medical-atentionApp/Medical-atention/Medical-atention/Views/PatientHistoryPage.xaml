<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Medical_atention.Controls"
             x:Class="Medical_atention.Views.PatientHistoryPage"
             BackgroundColor="#F0F4F8"
             Title="Historial Clínico">

    <Grid RowDefinitions="Auto,*">
        <controls:OfflineBannerView x:Name="OfflineBanner" Grid.Row="0" />

        <ScrollView Grid.Row="1">
            <StackLayout Padding="16,16,16,88" Spacing="16">

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="#2C7BE5"
                                   Margin="0,40,0,0" />

                <!-- Error state -->
                <Frame IsVisible="{Binding IsError}"
                       BackgroundColor="#FFF5F5"
                       BorderColor="#FEB2B2"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="False">
                    <Label Text="No se pudo cargar el historial del paciente."
                           TextColor="#C53030"
                           FontSize="14"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </Frame>

                <!-- Summary card -->
                <Frame BorderColor="#E2E8F0"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="False"
                       BackgroundColor="White">
                    <StackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0"
                                   Text="{Binding PatientName}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#1A365D"
                                   VerticalOptions="Center"
                                   LineBreakMode="TailTruncation" />
                            <controls:PriorityBadgeView Grid.Column="1"
                                                        Priority="{Binding CurrentPriority}"
                                                        Size="Medium"
                                                        IsVisible="{Binding HasPriority}"
                                                        VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#EDF2F7" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Total consultas"
                                       FontSize="12"
                                       TextColor="#718096" />
                                <Label Text="{Binding TotalConsultations}"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="#2C7BE5" />
                            </StackLayout>
                            <StackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Última consulta"
                                       FontSize="12"
                                       TextColor="#718096" />
                                <Label Text="{Binding LastConsultationDate}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#1A365D" />
                            </StackLayout>
                        </Grid>

                    </StackLayout>
                </Frame>

                <!-- Recent diagnoses -->
                <Label Text="Últimos diagnósticos"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="#1A365D"
                       Margin="4,0,0,0" />

                <CollectionView ItemsSource="{Binding RecentDiagnoses}"
                                SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="Sin diagnósticos registrados"
                               FontSize="13"
                               TextColor="#A0AEC0"
                               HorizontalOptions="Center"
                               Margin="0,8,0,0" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BorderColor="#E2E8F0"
                                   CornerRadius="10"
                                   Padding="14,10"
                                   HasShadow="False"
                                   BackgroundColor="White"
                                   Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="{Binding Diagnosis}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#1A202C"
                                           LineBreakMode="TailTruncation"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Date}"
                                           FontSize="12"
                                           TextColor="#718096"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Frequent medications -->
                <Label Text="Medicamentos frecuentes"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="#1A365D"
                       Margin="4,0,0,0" />

                <Frame BorderColor="#E2E8F0"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="False"
                       BackgroundColor="White">
                    <CollectionView ItemsSource="{Binding FrequentMedications}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="Sin medicamentos registrados"
                                   FontSize="13"
                                   TextColor="#A0AEC0"
                                   HorizontalOptions="Center" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"
                                      Padding="0,6,0,6">
                                    <BoxView Grid.Column="0"
                                             WidthRequest="6" HeightRequest="6"
                                             CornerRadius="3"
                                             BackgroundColor="#2C7BE5"
                                             VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="{Binding .}"
                                           FontSize="13"
                                           TextColor="#2D3748"
                                           VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Frame>

                <!-- Priority evolution -->
                <Label Text="Evolución de prioridad"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="#1A365D"
                       Margin="4,0,0,0" />

                <Frame BorderColor="#E2E8F0"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="False"
                       BackgroundColor="White">
                    <CollectionView ItemsSource="{Binding PriorityEvolution}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="Sin datos de prioridad"
                                   FontSize="13"
                                   TextColor="#A0AEC0"
                                   HorizontalOptions="Center" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="12"
                                      Padding="0,6,0,6">
                                    <BoxView Grid.Column="0"
                                             WidthRequest="2"
                                             BackgroundColor="#CBD5E0"
                                             VerticalOptions="Fill" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Date}"
                                           FontSize="13"
                                           TextColor="#4A5568"
                                           VerticalOptions="Center" />
                                    <controls:PriorityBadgeView Grid.Column="2"
                                                                Priority="{Binding Priority}"
                                                                Size="Small"
                                                                VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Frame>

                <!-- Ver historial completo -->
                <Button Text="Ver historial completo"
                        Clicked="OnViewFullHistoryClicked"
                        BackgroundColor="#2C7BE5"
                        TextColor="White"
                        CornerRadius="8"
                        FontAttributes="Bold"
                        FontSize="15"
                        HeightRequest="50"
                        Margin="0,4,0,0" />

            </StackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
