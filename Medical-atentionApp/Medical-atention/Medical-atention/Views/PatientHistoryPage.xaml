<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Medical_atention.Controls"
             x:Class="Medical_atention.Views.PatientHistoryPage"
             Title="Historial Clínico">

    <Grid RowDefinitions="Auto,*">
        <controls:OfflineBannerView x:Name="OfflineBanner" Grid.Row="0" />

        <ScrollView Grid.Row="1">
            <StackLayout Padding="16,16,16,88" Spacing="16">

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Margin="0,40,0,0" />

                <!-- Estado de error -->
                <Frame IsVisible="{Binding IsError}"
                       Style="{StaticResource ErrorFrameStyle}"
                       CornerRadius="12"
                       Padding="16">
                    <Label Text="No se pudo cargar el historial del paciente."
                           TextColor="{StaticResource ErrorDarkColor}"
                           FontSize="14"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </Frame>

                <!-- Tarjeta resumen -->
                <Frame Style="{StaticResource CardFrameStyle}">
                    <StackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0"
                                   Text="{Binding PatientName}"
                                   Style="{StaticResource TitleStyle}"
                                   FontSize="18"
                                   VerticalOptions="Center"
                                   LineBreakMode="TailTruncation" />
                            <controls:PriorityBadgeView Grid.Column="1"
                                                        Priority="{Binding CurrentPriority}"
                                                        Size="Medium"
                                                        IsVisible="{Binding HasPriority}"
                                                        VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light=#EDF2F7, Dark=#4A5568}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Total consultas" Style="{StaticResource CaptionStyle}" />
                                <Label Text="{Binding TotalConsultations}"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource PrimaryColor}" />
                            </StackLayout>
                            <StackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Última consulta" Style="{StaticResource CaptionStyle}" />
                                <Label Text="{Binding LastConsultationDate}"
                                       Style="{StaticResource BodyStyle}"
                                       FontAttributes="Bold" />
                            </StackLayout>
                        </Grid>

                    </StackLayout>
                </Frame>

                <!-- Últimos diagnósticos -->
                <Label Text="Últimos diagnósticos"
                       Style="{StaticResource SectionHeaderStyle}"
                       Margin="4,0,0,0" />

                <CollectionView ItemsSource="{Binding RecentDiagnoses}"
                                SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="Sin diagnósticos registrados"
                               Style="{StaticResource CaptionStyle}"
                               HorizontalOptions="Center"
                               Margin="0,8,0,0" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Style="{StaticResource CardFrameStyle}"
                                   CornerRadius="10"
                                   Padding="14,10"
                                   Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="{Binding Diagnosis}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#1A202C, Dark=#E2E8F0}"
                                           LineBreakMode="TailTruncation"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Date}"
                                           Style="{StaticResource CaptionStyle}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Medicamentos frecuentes -->
                <Label Text="Medicamentos frecuentes"
                       Style="{StaticResource SectionHeaderStyle}"
                       Margin="4,0,0,0" />

                <Frame Style="{StaticResource CardFrameStyle}">
                    <CollectionView ItemsSource="{Binding FrequentMedications}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="Sin medicamentos registrados"
                                   Style="{StaticResource CaptionStyle}"
                                   HorizontalOptions="Center" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"
                                      Padding="0,6,0,6">
                                    <BoxView Grid.Column="0"
                                             WidthRequest="6" HeightRequest="6"
                                             CornerRadius="3"
                                             BackgroundColor="{StaticResource PrimaryColor}"
                                             VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="{Binding .}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light=#2D3748, Dark=#E2E8F0}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Frame>

                <!-- Evolución de prioridad -->
                <Label Text="Evolución de prioridad"
                       Style="{StaticResource SectionHeaderStyle}"
                       Margin="4,0,0,0" />

                <Frame Style="{StaticResource CardFrameStyle}">
                    <CollectionView ItemsSource="{Binding PriorityEvolution}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="Sin datos de prioridad"
                                   Style="{StaticResource CaptionStyle}"
                                   HorizontalOptions="Center" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="12"
                                      Padding="0,6,0,6">
                                    <BoxView Grid.Column="0"
                                             WidthRequest="2"
                                             BackgroundColor="{AppThemeBinding Light=#CBD5E0, Dark=#4A5568}"
                                             VerticalOptions="Fill" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Date}"
                                           Style="{StaticResource BodySecondaryStyle}"
                                           FontSize="13"
                                           VerticalOptions="Center" />
                                    <controls:PriorityBadgeView Grid.Column="2"
                                                                Priority="{Binding Priority}"
                                                                Size="Small"
                                                                VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Frame>

                <Button Text="Ver historial completo"
                        Clicked="OnViewFullHistoryClicked"
                        Style="{StaticResource PrimaryButtonStyle}"
                        FontSize="15"
                        Margin="0,4,0,0" />

            </StackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
