<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Medical_atention.Controls"
             x:Class="Medical_atention.Views.PatientListPage"
             Title="Pacientes">

    <Grid RowDefinitions="Auto,*">
        <controls:OfflineBannerView x:Name="OfflineBanner" Grid.Row="0" />

        <Grid Grid.Row="1">
        <AbsoluteLayout x:Name="RootLayout">

        <StackLayout AbsoluteLayout.LayoutBounds="0,0,1,1"
                     AbsoluteLayout.LayoutFlags="All"
                     Padding="16,16,16,88" Spacing="0">

            <SearchBar Text="{Binding SearchText, Mode=TwoWay}"
                       Placeholder="Buscar por nombre o cédula (sin guiones)"
                       Margin="0,0,0,12" />

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Margin="0,40,0,0" />

            <!-- Estado vacío — sin pacientes -->
            <controls:EmptyStateView
                IsVisible="{Binding IsEmpty}"
                Icon="🏥"
                Title="Sin pacientes registrados"
                Subtitle="Registra el primero usando el botón +"
                VerticalOptions="CenterAndExpand"
                HorizontalOptions="CenterAndExpand" />

            <!-- Estado vacío — sin resultados de búsqueda -->
            <controls:EmptyStateView
                IsVisible="{Binding ShowSearchEmpty}"
                Icon="🔍"
                Title="{Binding EmptyMessage}"
                VerticalOptions="CenterAndExpand"
                HorizontalOptions="CenterAndExpand" />

            <CollectionView x:Name="PatientsList"
                            ItemsSource="{Binding FilteredPatients}"
                            IsVisible="{Binding HasFilteredResults}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Style="{StaticResource CardFrameStyle}"
                               Margin="0,0,0,10">
                            <Grid ColumnDefinitions="48,*,40" ColumnSpacing="12">
                                <Frame Grid.Column="0"
                                       BackgroundColor="{StaticResource PrimaryLightColor}"
                                       CornerRadius="24"
                                       Padding="0"
                                       HasShadow="False"
                                       HeightRequest="48"
                                       WidthRequest="48"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                                    <Label Text="{Binding Initials}"
                                           FontSize="16" FontAttributes="Bold"
                                           TextColor="{StaticResource PrimaryColor}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Frame>

                                <StackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding FullName}"
                                           FontSize="15" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#1A202C, Dark=#E2E8F0}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding IdentificationNumber, StringFormat='Cédula: {0}'}"
                                           Style="{StaticResource CaptionStyle}" />
                                    <controls:PriorityBadgeView Priority="{Binding Priority}"
                                                                Size="Small"
                                                                IsVisible="{Binding HasPriority}"
                                                                HorizontalOptions="Start" />
                                </StackLayout>

                                <Button Grid.Column="2"
                                        Text="⋮"
                                        FontSize="18"
                                        TextColor="#718096"
                                        BackgroundColor="{AppThemeBinding Light=#EDF2F7, Dark=#2D3748}"
                                        CornerRadius="20"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        Padding="0"
                                        VerticalOptions="Start"
                                        HorizontalOptions="End"
                                        Clicked="OnMenuClicked"
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </StackLayout>

        <BoxView x:Name="MenuOverlay"
                 Color="#80000000"
                 IsVisible="False"
                 AbsoluteLayout.LayoutBounds="0,0,1,1"
                 AbsoluteLayout.LayoutFlags="All">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMenuDismissed" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Frame x:Name="MenuPopup"
               IsVisible="False"
               BackgroundColor="{AppThemeBinding Light=White, Dark=#2D3748}"
               CornerRadius="12"
               Padding="0"
               HasShadow="True"
               BorderColor="{AppThemeBinding Light=#E2E8F0, Dark=#4A5568}"
               WidthRequest="260"
               AbsoluteLayout.LayoutBounds="0,0,260,220"
               AbsoluteLayout.LayoutFlags="None">
            <StackLayout Spacing="0">
                <Button Text="Ver Historial Completo"
                        Clicked="OnMenuHistorial"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light=#2D3748, Dark=#E2E8F0}"
                        FontSize="14"
                        HorizontalOptions="Fill"
                        Padding="16,14" />
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light=#EDF2F7, Dark=#4A5568}" />
                <Button Text="Detalle del Paciente"
                        Clicked="OnMenuDetail"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light=#2D3748, Dark=#E2E8F0}"
                        FontSize="14"
                        HorizontalOptions="Fill"
                        Padding="16,14" />
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light=#EDF2F7, Dark=#4A5568}" />
                <Button Text="Nueva Consulta"
                        Clicked="OnMenuNewConsultation"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light=#2D3748, Dark=#E2E8F0}"
                        FontSize="14"
                        HorizontalOptions="Fill"
                        Padding="16,14" />
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light=#EDF2F7, Dark=#4A5568}" />
                <Button Text="Eliminar Paciente"
                        Clicked="OnMenuDelete"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource ErrorColor}"
                        FontSize="14"
                        HorizontalOptions="Fill"
                        Padding="16,14" />
            </StackLayout>
        </Frame>

        </AbsoluteLayout>

        <Frame BackgroundColor="{StaticResource PrimaryColor}"
               CornerRadius="28"
               HasShadow="True"
               HeightRequest="56"
               WidthRequest="56"
               Padding="0"
               VerticalOptions="End"
               HorizontalOptions="End"
               Margin="0,0,24,24">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnAddPatientTapped" />
            </Frame.GestureRecognizers>
            <Label Text="+"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center" />
        </Frame>

        </Grid>
    </Grid>

</ContentPage>
