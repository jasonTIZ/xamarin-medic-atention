<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Medical_atention.Views.RegisterPatientPage"
             Title="Nuevo paciente">

    <Grid>
        <ScrollView>
            <StackLayout Padding="32,32,32,48" Spacing="0">

                <!-- Nombre -->
                <Label Text="Nombre completo"
                       Style="{StaticResource FieldLabelStyle}"
                       Margin="0,0,0,4" />
                <Frame Style="{StaticResource InputFrameStyle}">
                    <Entry Text="{Binding Name}"
                           Placeholder="Nombre del paciente"
                           ReturnType="Next" />
                </Frame>
                <Label Text="{Binding NameError}"
                       Style="{StaticResource ErrorLabelStyle}"
                       IsVisible="{Binding HasNameError}"
                       Margin="4,4,0,0" />

                <!-- Apellido -->
                <Label Text="Apellido"
                       Style="{StaticResource FieldLabelStyle}"
                       Margin="0,16,0,4" />
                <Frame Style="{StaticResource InputFrameStyle}">
                    <Entry Text="{Binding LastName}"
                           Placeholder="Apellido del paciente"
                           ReturnType="Next" />
                </Frame>
                <Label Text="{Binding LastNameError}"
                       Style="{StaticResource ErrorLabelStyle}"
                       IsVisible="{Binding HasLastNameError}"
                       Margin="4,4,0,0" />

                <!-- Cédula -->
                <Label Text="Cédula"
                       Style="{StaticResource FieldLabelStyle}"
                       Margin="0,16,0,4" />
                <Frame Style="{StaticResource InputFrameStyle}">
                    <Entry Text="{Binding IdentificationNumber}"
                           Placeholder="123456789"
                           Keyboard="Numeric"
                           ReturnType="Next" />
                </Frame>
                <Label Text="{Binding IdentificationNumberError}"
                       Style="{StaticResource ErrorLabelStyle}"
                       IsVisible="{Binding HasIdentificationNumberError}"
                       Margin="4,4,0,0" />

                <!-- Fecha de nacimiento -->
                <Label Text="Fecha de nacimiento"
                       Style="{StaticResource FieldLabelStyle}"
                       Margin="0,16,0,4" />
                <Frame Style="{StaticResource InputFrameStyle}" Padding="12,4">
                    <DatePicker Date="{Binding DateOfBirth}"
                                MaximumDate="{Binding MaxDateOfBirth}"
                                TextColor="{AppThemeBinding Light=#1A365D, Dark=#E2E8F0}"
                                BackgroundColor="Transparent"
                                Format="dd/MM/yyyy" />
                </Frame>
                <Label Text="{Binding DateError}"
                       Style="{StaticResource ErrorLabelStyle}"
                       IsVisible="{Binding HasDateError}"
                       Margin="4,4,0,0" />

                <!-- Género -->
                <Label Text="Género"
                       Style="{StaticResource FieldLabelStyle}"
                       Margin="0,16,0,4" />
                <Frame Style="{StaticResource InputFrameStyle}">
                    <Picker Title="Seleccionar género"
                            ItemsSource="{Binding Genders}"
                            SelectedItem="{Binding SelectedGender}"
                            TextColor="{AppThemeBinding Light=#1A365D, Dark=#E2E8F0}"
                            TitleColor="#A0AEC0"
                            BackgroundColor="Transparent" />
                </Frame>
                <Label Text="{Binding GenderError}"
                       Style="{StaticResource ErrorLabelStyle}"
                       IsVisible="{Binding HasGenderError}"
                       Margin="4,4,0,0" />

                <!-- Error general -->
                <Frame IsVisible="{Binding HasGeneralError}"
                       Style="{StaticResource ErrorFrameStyle}"
                       Margin="0,16,0,0">
                    <Label Text="{Binding GeneralError}"
                           TextColor="{StaticResource ErrorDarkColor}"
                           FontSize="14"
                           HorizontalOptions="Center" />
                </Frame>

                <!-- Botón registrar -->
                <Button Text="Registrar paciente"
                        Command="{Binding RegisterCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,24,0,0" />

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Margin="0,16,0,0" />

            </StackLayout>
        </ScrollView>

        <!-- Snackbar -->
        <Frame IsVisible="{Binding IsSnackbarVisible}"
               Style="{StaticResource SnackbarFrameStyle}"
               Margin="20,0,20,32"
               VerticalOptions="End"
               HorizontalOptions="Fill">
            <Label Text="{Binding SnackbarMessage}"
                   TextColor="White"
                   FontSize="14"
                   HorizontalOptions="Center" />
        </Frame>
    </Grid>

</ContentPage>
