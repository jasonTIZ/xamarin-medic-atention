<?xml version="1.0" encoding="UTF-8"?>
<ContentView xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Medical_atention.Controls.EmptyStateView"
             x:Name="Root">

    <StackLayout VerticalOptions="CenterAndExpand"
                 HorizontalOptions="CenterAndExpand"
                 Padding="32,40"
                 Spacing="12">

        <Label Text="{Binding Icon, Source={x:Reference Root}}"
               FontSize="48"
               HorizontalOptions="Center"
               TextColor="#A0AEC0" />

        <Label Text="{Binding Title, Source={x:Reference Root}}"
               FontSize="16"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light=#718096, Dark=#A0AEC0}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center" />

        <Label Text="{Binding Subtitle, Source={x:Reference Root}}"
               FontSize="13"
               TextColor="#A0AEC0"
               IsVisible="{Binding HasSubtitle, Source={x:Reference Root}}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center" />

        <Button Text="{Binding ActionText, Source={x:Reference Root}}"
                Command="{Binding ActionCommand, Source={x:Reference Root}}"
                Style="{StaticResource PrimaryButtonStyle}"
                IsVisible="{Binding HasAction, Source={x:Reference Root}}"
                Margin="0,8,0,0" />

    </StackLayout>

</ContentView>
