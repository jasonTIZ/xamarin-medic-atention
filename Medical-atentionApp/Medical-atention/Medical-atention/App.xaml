<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:Medical_atention.Converters"
             x:Class="Medical_atention.App">
    <Application.Resources>
        <ResourceDictionary>
            <converters:PriorityLevelToColorConverter x:Key="PriorityColorConverter" />

            <!-- ════════════════════════════════════════════════
                 PALETA DE COLORES — tokens estáticos
                 ════════════════════════════════════════════════ -->
            <Color x:Key="PrimaryColor">#2C7BE5</Color>
            <Color x:Key="PrimaryLightColor">#EBF4FF</Color>
            <Color x:Key="PrimaryBorderColor">#BEE3F8</Color>

            <Color x:Key="UrgentColor">#E53E3E</Color>
            <Color x:Key="HighColor">#DD6B20</Color>
            <Color x:Key="MediumColor">#D69E2E</Color>
            <Color x:Key="LowColor">#38A169</Color>

            <Color x:Key="ErrorColor">#E53E3E</Color>
            <Color x:Key="ErrorDarkColor">#C53030</Color>

            <Color x:Key="SuccessLightColor">#F0FFF4</Color>
            <Color x:Key="SuccessBorderColor">#9AE6B4</Color>
            <Color x:Key="SuccessTextColor">#276749</Color>

            <Color x:Key="WarningLightColor">#FFFAF0</Color>
            <Color x:Key="WarningBorderColor">#F6AD55</Color>
            <Color x:Key="WarningTextColor">#C05621</Color>
            <Color x:Key="WarningDarkTextColor">#7B341E</Color>
            <Color x:Key="WarningOrangeColor">#DD6B20</Color>

            <!-- ════════════════════════════════════════════════
                 ESTILOS IMPLÍCITOS — adaptables en Dark Mode
                 Aplican automáticamente cuando el elemento NO
                 tiene la propiedad definida localmente.
                 ════════════════════════════════════════════════ -->

            <!-- Fondo de página -->
            <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light=#F0F4F8, Dark=#1A202C}" />
            </Style>

            <!-- Campos de texto -->
            <Style TargetType="Entry">
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=#1A365D, Dark=#E2E8F0}" />
                <Setter Property="PlaceholderColor" Value="#A0AEC0" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

            <Style TargetType="Editor">
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=#1A365D, Dark=#E2E8F0}" />
                <Setter Property="PlaceholderColor" Value="#A0AEC0" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

            <!-- Barra de búsqueda -->
            <Style TargetType="SearchBar">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light=White, Dark=#2D3748}" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=#1A365D, Dark=#E2E8F0}" />
                <Setter Property="PlaceholderColor" Value="#A0AEC0" />
                <Setter Property="CancelButtonColor" Value="#2C7BE5" />
            </Style>

            <!-- Indicador de carga -->
            <Style TargetType="ActivityIndicator">
                <Setter Property="Color" Value="#2C7BE5" />
            </Style>

            <!-- ════════════════════════════════════════════════
                 TIPOGRAFÍA — estilos de label con clave
                 ════════════════════════════════════════════════ -->
            <Style x:Key="TitleStyle" TargetType="Label">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=#1A365D, Dark=#E2E8F0}" />
            </Style>

            <Style x:Key="SubtitleStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=#718096, Dark=#A0AEC0}" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="Label">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=#1A365D, Dark=#CBD5E0}" />
            </Style>

            <Style x:Key="BodyStyle" TargetType="Label">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=#1A365D, Dark=#E2E8F0}" />
            </Style>

            <Style x:Key="BodySecondaryStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=#4A5568, Dark=#A0AEC0}" />
            </Style>

            <Style x:Key="CaptionStyle" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=#718096, Dark=#A0AEC0}" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=#4A5568, Dark=#A0AEC0}" />
            </Style>

            <Style x:Key="ErrorLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="#E53E3E" />
            </Style>

            <!-- ════════════════════════════════════════════════
                 BOTONES
                 ════════════════════════════════════════════════ -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#2C7BE5" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="HeightRequest" Value="50" />
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light=#E2E8F0, Dark=#4A5568}" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light=#4A5568, Dark=#E2E8F0}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>

            <Style x:Key="DangerButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="#E53E3E" />
                <Setter Property="BorderColor" Value="#E53E3E" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="HeightRequest" Value="50" />
            </Style>

            <Style x:Key="OutlineButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#EBF8FF" />
                <Setter Property="TextColor" Value="#2C7BE5" />
                <Setter Property="BorderColor" Value="#BEE3F8" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HeightRequest" Value="40" />
            </Style>

            <!-- ════════════════════════════════════════════════
                 FRAMES (tarjetas, inputs, alertas, snackbar)
                 ════════════════════════════════════════════════ -->
            <Style x:Key="CardFrameStyle" TargetType="Frame">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light=White, Dark=#2D3748}" />
                <Setter Property="BorderColor"
                        Value="{AppThemeBinding Light=#E2E8F0, Dark=#4A5568}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="InputFrameStyle" TargetType="Frame">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light=White, Dark=#2D3748}" />
                <Setter Property="BorderColor"
                        Value="{AppThemeBinding Light=#CBD5E0, Dark=#4A5568}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="Padding" Value="12,0" />
            </Style>

            <Style x:Key="ErrorFrameStyle" TargetType="Frame">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light=#FFF5F5, Dark=#2D1515}" />
                <Setter Property="BorderColor"
                        Value="{AppThemeBinding Light=#FEB2B2, Dark=#FC8181}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="Padding" Value="12,10" />
            </Style>

            <Style x:Key="SnackbarFrameStyle" TargetType="Frame">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light=#323232, Dark=#1A1A1A}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HasShadow" Value="True" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="BorderColor" Value="Transparent" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
